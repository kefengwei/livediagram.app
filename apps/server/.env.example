# The self-hosted stack (docs/specs/016-platform/blueprints/self-hosted-runtime.md).
# Copy to .env beside docker-compose.yml and fill in the secret.

# Signs sessions and mints the JWTs the api verifies. REQUIRED.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The origin people reach. Drives Better Auth's base URL, and the JWKS the api
# trusts when nothing else is configured.
PUBLIC_ORIGIN=http://localhost:8080

# Which image to build: `runtime` (default) bakes the five static sites in; `app` is
# the api alone — pair it with STATIC_ROOT=/srv and the ./data-static mount when you
# serve a build made on the host, which is much faster to iterate on.
#
# NOTE for the APP_TARGET=app path: the sites are then built on YOUR machine, and
# the editor needs NEXT_PUBLIC_SELF_HOST_AUTH=1 at that moment — the image sets it
# for its own build, but cannot for yours:
#
#   NEXT_PUBLIC_SELF_HOST_AUTH=1 pnpm build
#
# Without it the editor still signs in (it probes /api/auth/ok at runtime), but the
# choices made at module load stay off: no account menu, no API-token settings, and
# the MCP consent page says connecting apps isn't available.
APP_TARGET=runtime
STATIC_ROOT=/app/static

# Where Caddy listens. Set SITE_ADDRESS to a domain to get automatic HTTPS.
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=:80

# The ports the two processes listen on INSIDE the stack. Change these and
# everything follows: the healthchecks read them back out of each process's own
# environment, the MCP calls the api on APP_PORT, and Caddy proxies to both. The
# defaults are the image's own; there is normally no reason to touch them.
# APP_PORT=8787
# MCP_PORT=8788

# Where the MCP server answers (apps/mcp, run as the `mcp` service). It needs its
# OWN origin: an MCP client asks for the OAuth discovery documents at /.well-known/
# on the MCP host, and your app's origin already answers those paths for itself.
# The default resolves to this machine on every desktop OS — clients then use
# OPTIONAL. The MCP is served from SITE_ADDRESS under /mcp; set this only to give it
# a second, dedicated host (a certificate is obtained for it, so DNS must point here
# first). Clients on other machines need a name they can resolve — *.localhost means
# their own machine — which is the usual reason to set it.
MCP_SITE_ADDRESS=http://mcp.localhost

# Optional: the shared secret that marks telemetry from the api and the MCP as
# internal, so it skips the anonymous per-IP rate-limit bucket. Unset is fine: the
# events still arrive, they just share the bucket (docs/specs/017-telemetry/telemetry.md).
# INTERNAL_EVENTS_KEY=

# Optional: a Google OAuth client, so people can sign in with Google as well as a
# one-time code.
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=

# Optional: Feishu (Lark) sign-in. Create a 自建应用 at https://open.feishu.cn/app, then
# add this as its Redirect URL — the path is what Better Auth answers on, verified
# against a running instance, not the /oauth2/ form its docs show for other providers:
#
#   <PUBLIC_ORIGIN>/api/auth/callback/feishu
#
# People then sign in with their Feishu identity. The ACCOUNT is keyed by the
# tenant-stable union_id, so the contact:user.email:readonly scope is not needed to
# identify anyone — but Better Auth requires every user row to carry an email, so
# without that scope people get a placeholder at <union_id>@feishu.invalid (RFC 2606:
# a domain that can never resolve). Grant the scope if you want their real address.
# AUTH_FEISHU_APP_ID=
# AUTH_FEISHU_APP_SECRET=

# Optional: mail for the sign-in codes. Without it the codes are printed to the
# container log, which is enough to sign in.
# RESEND_API_KEY=
# RESEND_FROM=

# Optional: the editor's AI panel. Without a key it is hidden entirely.
# OPENAI_API_KEY=
# GOOGLE_AI_STUDIO_API_KEY=

# Optional: the anonymous product analytics the hosted site runs.
# TELEMETRY_ENABLED=true