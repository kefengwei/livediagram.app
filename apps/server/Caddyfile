# TLS, and a proxy. Nothing else.
#
# The routing table — which path belongs to which app, the /live asset prefix, the
# single placeholder page every /document/<id> resolves to — lives in the app
# process (apps/server/src/static.ts), because it is the application's rule and the
# hosted deployment keeps it in code too. Restating it here would give it two
# sources of truth.
#
# SITE_ADDRESS drives automatic HTTPS: set it to a domain and Caddy obtains a
# certificate; leave it as :80 for a local or LAN deployment.

{$SITE_ADDRESS} {
	encode zstd gzip

	# The MCP, reached as a path on this host instead of as its own origin
	# (docs/specs/016-platform/self-hosted-runtime.md). Two rules, deliberately —
	# NOT one per endpoint: everything the MCP serves lives under /mcp, and the
	# discovery documents it must answer at the origin root are all
	# /.well-known/oauth-*, which nothing else here claims. Adding an OAuth
	# endpoint to the MCP therefore needs no change to this file.
	handle /mcp* {
		reverse_proxy mcp:{$MCP_PORT:8788}
	}
	handle /.well-known/oauth-* {
		reverse_proxy mcp:{$MCP_PORT:8788}
	}

	# The api, the rooms, the identity provider and the built sites: one process.
	# The port comes from the environment docker-compose.yml hands this container,
	# which is the same number the app service was given.
	handle {
		reverse_proxy app:{$APP_PORT:8787}
	}

	# A self-host on a LAN usually speaks plain HTTP; these keep the browser's
	# stricter defaults from breaking the editor there.
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# The MCP process, optionally ALSO on its own origin — the same choice the hosted
# deployment makes (mcp.livediagram.app). Both mounts reach the same handlers, so a
# client configured either way works; set MCP_SITE_ADDRESS to a host that resolves
# here to use this one (docs/specs/016-platform/self-hosted-runtime.md, "Static apps
# and routing"). Leave it unset and the path mount above is the whole story.
{$MCP_SITE_ADDRESS} {
	encode zstd gzip

	reverse_proxy mcp:{$MCP_PORT:8788}
}
